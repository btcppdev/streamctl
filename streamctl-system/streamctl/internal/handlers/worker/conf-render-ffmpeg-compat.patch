diff --git a/tests/test_concat_seek.py b/tests/test_concat_seek.py
new file mode 100644
--- /dev/null
+++ b/tests/test_concat_seek.py
@@ -0,0 +1,54 @@
+"""Regressions for expensive failed seeks into chunked recordings."""
+
+import json
+from pathlib import Path
+import shutil
+import subprocess
+
+import pytest
+
+from conf_render.ffmpeg import _write_concat_file, write_artifacts
+from conf_render.models import Manifest
+from conf_render.probe import probe_chunked_media
+from conf_render.timeline import build_plan
+
+
+@pytest.mark.parametrize("durations", [(), (1000,), (1000, 0), (1000, -1)])
+def test_missing_chunk_durations_fail_before_render(tmp_path: Path, durations: tuple[int, ...]) -> None:
+    with pytest.raises(ValueError, match="chunk durations"):
+        _write_concat_file((Path("one.mp4"), Path("two.mp4")), tmp_path / "chunks.ffconcat", durations)
+
+
+@pytest.mark.skipif(not shutil.which("ffmpeg") or not shutil.which("ffprobe"), reason="FFmpeg unavailable")
+def test_chunked_input_is_seekable(tmp_path: Path) -> None:
+    # Spaces exercise the actual concat parser, not just text output.
+    paths = tuple(tmp_path / f"speaker talk_{index:04d}.mp4" for index in range(2))
+    for path, color in zip(paths, ("red", "green")):
+        subprocess.run([
+            "ffmpeg", "-v", "error", "-nostdin", "-y", "-f", "lavfi", "-i",
+            f"color={color}:size=96x54:rate=12:duration=1", "-c:v", "libx264",
+            "-threads", "1", "-bf", "0", "-pix_fmt", "yuv420p", str(path),
+        ], check=True)
+    info = probe_chunked_media(paths[0], paths)
+    manifest = Manifest.model_validate({
+        "version": 1,
+        "settings": {"width": 96, "height": 54, "fps": 12, "videoEncoder": "software"},
+        "jobs": [{"id": "seek", "segments": [{
+            "type": "chunkedVideo", "src": str(paths[0]),
+            "in": "00:00:00.500", "out": "00:00:01.800",
+        }]}],
+    })
+    plan = build_plan(manifest.jobs[0], manifest.settings, {paths[0]: info})
+    artifacts = write_artifacts(plan, tmp_path / "output.mp4", tmp_path / "work", True)
+    concat = artifacts.concat_files[0]
+    # ffprobe requires a real seek here. A list without durations fails instead
+    # of decoding from the beginning as a normal ffmpeg render would do.
+    result = subprocess.run([
+        "ffprobe", "-v", "error", "-f", "concat", "-safe", "0",
+        "-read_intervals", "0.500%+0.1", "-select_streams", "v:0",
+        "-show_entries", "packet=pts_time", "-of", "json", str(concat),
+    ], capture_output=True, text=True, check=True)
+    assert not result.stderr.strip()
+    packets = json.loads(result.stdout)["packets"]
+    assert packets
+    assert 0.0 <= float(packets[0]["pts_time"]) <= 0.5
diff --git a/tests/test_render_diagnostics.py b/tests/test_render_diagnostics.py
new file mode 100644
--- /dev/null
+++ b/tests/test_render_diagnostics.py
@@ -0,0 +1,48 @@
+from pathlib import Path
+import sys
+
+import pytest
+
+from conf_render.ffmpeg import build_command
+from conf_render.progress import FFmpegError, run_ffmpeg
+from test_ffmpeg import make_audio_plan
+
+
+def test_each_input_and_output_has_explicit_threads(monkeypatch):
+    monkeypatch.setattr("conf_render.ffmpeg.resolve_video_encoder", lambda requested: "libx264")
+    monkeypatch.setenv("STREAMCTL_RENDER_INPUT_THREADS", "2")
+    monkeypatch.setenv("STREAMCTL_RENDER_FILTER_THREADS", "4")
+    command = build_command(make_audio_plan(), Path("output.mp4"), True)
+    previous = 0
+    for index, value in enumerate(command):
+        if value == "-i":
+            options = command[previous:index]
+            assert options[options.index("-threads") + 1] == "2"
+            previous = index + 2
+    options = command[previous:]
+    assert options[options.index("-threads") + 1] == "2"
+    assert command[command.index("-filter_complex_threads") + 1] == "4"
+
+
+@pytest.mark.parametrize("value", ["0", "-1", "65", "bad"])
+def test_invalid_thread_limits_fail_before_launch(monkeypatch, value):
+    monkeypatch.setenv("STREAMCTL_RENDER_INPUT_THREADS", value)
+    with pytest.raises(ValueError):
+        build_command(make_audio_plan(), Path("output.mp4"), True)
+
+
+def test_sigkill_keeps_complete_ffmpeg_stderr(tmp_path, monkeypatch):
+    script = tmp_path / "fake-ffmpeg"
+    script.write_text(f"#!{sys.executable}\nimport os,signal,sys\n"
+                      "sys.stderr.write('Original failure evidence\\n' + 'noise\\n' * 500)\n"
+                      "sys.stderr.flush()\nos.kill(os.getpid(), signal.SIGKILL)\n")
+    script.chmod(0o755)
+    directory = tmp_path / "diagnostics"
+    monkeypatch.setenv("STREAMCTL_RENDER_DIAGNOSTICS_DIR", str(directory))
+    messages = []
+    with pytest.raises(FFmpegError, match="exit -9"):
+        run_ffmpeg([str(script)], 1000, report=messages.append)
+    files = list(directory.glob("*.stderr.log"))
+    assert len(files) == 1
+    assert files[0].read_text().startswith("Original failure evidence\n")
+    assert "Original failure evidence" in "\n".join(messages)
